{
  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ResourceServer": {
    "BaseUrl": "https://localhost:5001"
  },
  "Guardhouse": {
    "Authority": "https://your-guardhouse-server.com",
    "ClientId": "your-client-id",
    "ClientSecret": "your-client-secret",
    "Scope": "api",
    "EnableDebug": true
  }
}
